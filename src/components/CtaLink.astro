---
import OutcomeLine from './brand/OutcomeLine.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center font-mono text-[11px] tracking-[0.16em] no-underline transition-colors',
    variant === 'primary' &&
      'bg-horizon-600 px-6 py-3 text-white hover:bg-graphite-950',
    variant === 'secondary' && 'gap-3 text-ink hover:text-horizon-600',
    className,
  ]}
>
  <slot />
  {variant === 'secondary' && <OutcomeLine class="w-16" />}
</a>
