---
interface Props {
  title: string;
  href: string;
  shortDescription: string;
  duration: string;
  level: string;
  audienceLabel: string;
  categoryTitle: string;
}

const { title, href, shortDescription, duration, level, audienceLabel, categoryTitle } =
  Astro.props;
---

<article class="flex h-full flex-col border-b border-hairline py-8 md:py-10">
  <p class="font-mono text-[11px] tracking-[0.14em] text-muted">
    {duration}
    {' · '}
    {level}
    {' · '}
    {categoryTitle}
  </p>
  <h3 class="mt-3 text-[1.15rem] font-medium tracking-tight">
    <a href={href} class="text-ink no-underline hover:text-cobalt">
      {title}
    </a>
  </h3>
  <p class="mt-3 max-w-xl flex-1 text-[0.98rem] leading-relaxed text-muted">
    {shortDescription}
  </p>
  <p class="mt-4 font-mono text-[11px] tracking-[0.12em] text-muted">
    {audienceLabel}
  </p>
</article>
