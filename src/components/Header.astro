---
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import { nav, currentPath, isActivePath } from '../data/site';
import { products, productHref } from '../data/products';

const path = currentPath(Astro.url.pathname);
const isHome = path === '/';
---

<header class="relative z-30 border-b border-hairline">
  <div class="h-[3px] bg-cobalt" aria-hidden="true"></div>
  <div
    class="mx-auto flex max-w-[88rem] flex-col gap-5 px-6 py-5 sm:flex-row sm:items-center sm:justify-between md:px-10 lg:px-16"
  >
    <a
      href="/"
      class="flex items-center gap-3 no-underline"
      aria-label="Cognitecta home"
    >
      <Mark class="size-7 text-ink" />
      {
        !isHome && (
          <Wordmark class="text-[0.7rem] tracking-[0.28em] sm:text-[0.78rem]" />
        )
      }
    </a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-4 gap-y-2 sm:gap-x-6">
        {
          nav.map((item) => {
            const active = isActivePath(path, item.href);
            const isProducts = item.href === '/products';
            return (
              <li class:list={[isProducts && 'nav-products relative py-1']}>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'font-mono text-[11px] tracking-[0.16em] no-underline',
                    active ? 'text-cobalt' : 'text-ink hover:text-cobalt',
                  ]}
                >
                  {item.label}
                </a>
                {isProducts && (
                  <ul class="nav-products__menu absolute top-full left-0 z-20 hidden w-48 flex-col border border-hairline bg-paper">
                    {products.map((product) => (
                      <li class="border-b border-hairline last:border-b-0">
                        <a
                          href={productHref(product.slug)}
                          class:list={[
                            'block px-4 py-2.5 font-mono text-[11px] tracking-[0.14em] no-underline',
                            isActivePath(path, productHref(product.slug))
                              ? 'text-cobalt'
                              : 'text-ink hover:text-cobalt',
                          ]}
                        >
                          {product.name}
                          <span class="mt-0.5 block tracking-[0.1em] text-muted">
                            {product.verb}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  @media (min-width: 1024px) {
    .nav-products:hover .nav-products__menu,
    .nav-products:focus-within .nav-products__menu {
      display: flex;
    }

    .nav-products__menu::before {
      content: '';
      position: absolute;
      right: 0;
      bottom: 100%;
      left: 0;
      height: 0.55rem;
    }
  }
</style>

