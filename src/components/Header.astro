---
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import { nav, currentPath, isActivePath } from '../data/site';
import { products, productHref } from '../data/products';

const path = currentPath(Astro.url.pathname);
const isHome = path === '/';
---

<header class="border-b border-hairline">
  <div class="h-[3px] bg-cobalt" aria-hidden="true"></div>
  <div
    class="mx-auto flex max-w-[88rem] flex-col gap-5 px-6 py-5 sm:flex-row sm:items-center sm:justify-between md:px-10 lg:px-16"
  >
    <a
      href="/"
      class="flex items-center gap-3 no-underline"
      aria-label="Cognitecta home"
    >
      <Mark class="size-7 text-ink" />
      {
        !isHome && (
          <Wordmark class="text-[0.7rem] tracking-[0.28em] sm:text-[0.78rem]" />
        )
      }
    </a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-4 gap-y-2 sm:gap-x-6">
        {
          nav.map((item) => {
            const active = isActivePath(path, item.href);
            const isProducts = item.href === '/products';
            return (
              <li class:list={[isProducts && 'group relative py-1']}>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'font-mono text-[11px] tracking-[0.16em] no-underline',
                    active ? 'text-cobalt' : 'text-ink hover:text-cobalt',
                  ]}
                >
                  {item.label}
                </a>
                {isProducts && (
                  <ul class="absolute top-full left-0 z-20 hidden w-44 flex-col gap-2 border border-hairline bg-paper px-4 py-3 lg:group-hover:flex lg:group-focus-within:flex">
                    {products.map((product) => (
                      <li>
                        <a
                          href={productHref(product.slug)}
                          class:list={[
                            'font-mono text-[11px] tracking-[0.14em] no-underline',
                            isActivePath(path, productHref(product.slug))
                              ? 'text-cobalt'
                              : 'text-ink hover:text-cobalt',
                          ]}
                        >
                          {product.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
