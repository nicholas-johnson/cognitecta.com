---
import { site, founder } from '../data/site';
import { products, productHref } from '../data/products';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organisation`,
      name: site.name,
      url: site.url,
      email: site.email,
      description: site.description,
      logo: `${site.url}/favicon.svg`,
      image: `${site.url}/og.png`,
      sameAs: [founder.linkedin],
      founder: { '@id': `${site.url}/#founder` },
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#founder`,
      name: founder.name,
      jobTitle: founder.role,
      url: `${site.url}/about`,
      sameAs: [founder.linkedin],
      worksFor: { '@id': `${site.url}/#organisation` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#service`,
      name: site.name,
      url: site.url,
      description: site.description,
      areaServed: 'GB',
      serviceType: [
        'AI training',
        'AI consultancy',
        'Production AI systems',
        'Agentic AI products',
      ],
      provider: { '@id': `${site.url}/#organisation` },
      hasOfferCatalog: { '@id': `${site.url}/#products` },
    },
    {
      '@type': 'OfferCatalog',
      '@id': `${site.url}/#products`,
      name: 'Cognitecta products',
      url: `${site.url}/products`,
      itemListElement: products.map((product, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'SoftwareApplication',
          name: product.fullName,
          applicationCategory: 'BusinessApplication',
          url: `${site.url}${productHref(product.slug)}`,
          description: product.seoDescription,
        },
      })),
    },
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
