---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['relative border border-hairline', className]}>
  <span class="pointer-events-none absolute -top-px -left-px h-2 w-2 border-t border-l border-ink" aria-hidden="true"></span>
  <span class="pointer-events-none absolute -top-px -right-px h-2 w-2 border-t border-r border-ink" aria-hidden="true"></span>
  <span class="pointer-events-none absolute -bottom-px -left-px h-2 w-2 border-b border-l border-ink" aria-hidden="true"></span>
  <span class="pointer-events-none absolute -right-px -bottom-px h-2 w-2 border-r border-b border-ink" aria-hidden="true"></span>
  <slot />
</div>
