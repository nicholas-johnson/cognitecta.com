---
import GridFrame from '../diagrams/GridFrame.astro';

interface Props {
  slug: string;
  compact?: boolean;
  class?: string;
}

const { slug, compact = false, class: className } = Astro.props;

const copy: Record<string, { kicker: string; line: string }> = {
  'itad-assist': {
    kicker: 'Recovery routes',
    line: 'One retired asset resolves into the route with the most remaining value.',
  },
  roborigs: {
    kicker: 'Design pipeline',
    line: 'A described concept becomes parts, checks and a printable mesh.',
  },
  tabbytutor: {
    kicker: 'Learning loop',
    line: 'A lesson is a conversation; a filled streak unlocks real-world lore.',
  },
};

const meta = copy[slug];
---

{
  compact ? (
    <div class:list={['border border-hairline bg-paper p-4', className]}>
      <svg class="h-20 w-full text-ink" viewBox="0 0 240 120" fill="none" aria-hidden="true">
        {slug === 'itad-assist' && (
          <g>
            <rect x="96" y="10" width="48" height="22" stroke="currentColor" stroke-opacity="0.55" />
            <path
              d="M120 32v10M120 42H26v16M120 42H73v16M120 42h47v16M120 42h94v16"
              stroke="currentColor"
              stroke-opacity="0.4"
            />
            <rect x="8" y="58" width="36" height="20" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="55" y="58" width="36" height="20" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="151" y="58" width="36" height="20" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="198" y="58" width="36" height="20" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="102" y="58" width="36" height="20" stroke="#145BFF" />
            <rect x="116" y="92" width="8" height="16" fill="#145BFF" />
            <rect x="20" y="98" width="8" height="10" fill="currentColor" fill-opacity="0.35" />
            <rect x="67" y="96" width="8" height="12" fill="currentColor" fill-opacity="0.35" />
            <rect x="165" y="100" width="8" height="8" fill="currentColor" fill-opacity="0.35" />
            <rect x="212" y="102" width="8" height="6" fill="currentColor" fill-opacity="0.35" />
          </g>
        )}
        {slug === 'roborigs' && (
          <g>
            <circle cx="20" cy="20" r="9" stroke="currentColor" stroke-opacity="0.6" />
            <circle cx="46" cy="20" r="9" stroke="currentColor" stroke-opacity="0.4" />
            <path d="M62 20h26" stroke="currentColor" stroke-opacity="0.4" />
            <rect x="98" y="34" width="44" height="30" stroke="currentColor" />
            <rect x="110" y="14" width="20" height="18" stroke="currentColor" stroke-opacity="0.7" />
            <path d="M120 14v-6" stroke="#145BFF" />
            <rect x="118" y="4" width="4" height="4" fill="#145BFF" />
            <rect x="102" y="64" width="12" height="20" stroke="currentColor" stroke-opacity="0.7" />
            <rect x="126" y="64" width="12" height="20" stroke="currentColor" stroke-opacity="0.7" />
            <path d="M160 34h64v52h-64z" stroke="#145BFF" />
            <path d="M176 34v52M192 34v52M208 34v52M160 50h64M160 68h64" stroke="#145BFF" stroke-opacity="0.35" />
          </g>
        )}
        {slug === 'tabbytutor' && (
          <g>
            <rect x="8" y="10" width="96" height="20" stroke="currentColor" stroke-opacity="0.55" />
            <path d="M26 30v8l12-8" stroke="currentColor" stroke-opacity="0.55" />
            <rect x="120" y="34" width="104" height="20" stroke="#145BFF" />
            <path d="M204 54v8l-12-8" stroke="#145BFF" />
            <g stroke="currentColor" stroke-opacity="0.5">
              <rect x="8" y="70" width="20" height="20" />
              <rect x="34" y="70" width="20" height="20" />
              <rect x="60" y="70" width="20" height="20" />
              <rect x="86" y="70" width="20" height="20" />
              <rect x="112" y="70" width="20" height="20" />
              <rect x="138" y="70" width="20" height="20" />
            </g>
            <rect x="8" y="102" width="200" height="10" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="8" y="102" width="120" height="10" fill="#145BFF" fill-opacity="0.55" />
            <rect x="218" y="100" width="14" height="14" fill="#145BFF" />
          </g>
        )}
      </svg>
    </div>
  ) : (
    <GridFrame class:list={['h-full bg-paper p-6 md:p-8', className]}>
      {meta && <p class="font-mono text-[11px] tracking-[0.18em] text-cobalt">{meta.kicker}</p>}
      <svg class="mt-6 h-40 w-full text-ink" viewBox="0 0 240 150" fill="none" aria-hidden="true">
        {slug === 'itad-assist' && (
          <g>
            <rect x="94" y="12" width="52" height="26" stroke="currentColor" stroke-opacity="0.55" />
            <path
              d="M120 38v14M120 52H28v18M120 52H74v18M120 52h46v18M120 52h92v18"
              stroke="currentColor"
              stroke-opacity="0.4"
            />
            <rect x="8" y="70" width="40" height="24" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="54" y="70" width="40" height="24" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="146" y="70" width="40" height="24" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="192" y="70" width="40" height="24" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="100" y="70" width="40" height="24" stroke="#145BFF" />
            <path d="M8 138h224" stroke="currentColor" stroke-opacity="0.3" />
            <rect x="18" y="124" width="20" height="14" fill="currentColor" fill-opacity="0.3" />
            <rect x="64" y="118" width="20" height="20" fill="currentColor" fill-opacity="0.3" />
            <rect x="110" y="104" width="20" height="34" fill="#145BFF" />
            <rect x="156" y="126" width="20" height="12" fill="currentColor" fill-opacity="0.3" />
            <rect x="202" y="130" width="20" height="8" fill="currentColor" fill-opacity="0.3" />
            <rect x="117" y="94" width="6" height="6" fill="#145BFF" />
          </g>
        )}
        {slug === 'roborigs' && (
          <g>
            <circle cx="24" cy="26" r="12" stroke="currentColor" stroke-opacity="0.6" />
            <circle cx="56" cy="26" r="12" stroke="currentColor" stroke-opacity="0.4" />
            <circle cx="40" cy="54" r="12" stroke="currentColor" stroke-opacity="0.25" />
            <path d="M74 34h22" stroke="currentColor" stroke-opacity="0.4" />
            <rect x="96" y="46" width="52" height="40" stroke="currentColor" />
            <rect x="110" y="20" width="24" height="22" stroke="currentColor" stroke-opacity="0.7" />
            <path d="M122 20v-8" stroke="#145BFF" />
            <rect x="119" y="6" width="6" height="6" fill="#145BFF" />
            <rect x="100" y="86" width="14" height="26" stroke="currentColor" stroke-opacity="0.7" />
            <rect x="130" y="86" width="14" height="26" stroke="currentColor" stroke-opacity="0.7" />
            <path d="M164 40h68v66h-68z" stroke="#145BFF" />
            <path
              d="M181 40v66M198 40v66M215 40v66M164 62h68M164 84h68"
              stroke="#145BFF"
              stroke-opacity="0.35"
            />
            <path d="M148 60l16-8M148 82l16 6" stroke="currentColor" stroke-opacity="0.3" />
          </g>
        )}
        {slug === 'tabbytutor' && (
          <g>
            <rect x="8" y="12" width="104" height="24" stroke="currentColor" stroke-opacity="0.55" />
            <path d="M28 36v10l14-10" stroke="currentColor" stroke-opacity="0.55" />
            <rect x="120" y="44" width="112" height="24" stroke="#145BFF" />
            <path d="M210 68v10l-14-10" stroke="#145BFF" />
            <g stroke="currentColor" stroke-opacity="0.5">
              <rect x="8" y="86" width="24" height="24" />
              <rect x="40" y="86" width="24" height="24" />
              <rect x="72" y="86" width="24" height="24" />
              <rect x="104" y="86" width="24" height="24" />
              <rect x="136" y="86" width="24" height="24" />
              <rect x="168" y="86" width="24" height="24" />
            </g>
            <rect x="8" y="126" width="200" height="12" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="8" y="126" width="118" height="12" fill="#145BFF" fill-opacity="0.55" />
            <rect x="216" y="123" width="16" height="16" fill="#145BFF" />
          </g>
        )}
      </svg>
      {meta && (
        <p class="mt-6 max-w-xs font-mono text-[11px] leading-relaxed tracking-[0.08em] text-muted">
          {meta.line}
        </p>
      )}
    </GridFrame>
  )
}
