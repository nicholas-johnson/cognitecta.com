---
import ResolutionMark from '../brand/ResolutionMark.astro';
import CtaLink from '../CtaLink.astro';
import { site } from '../../data/site';
---

<section class="border-b border-hairline">
  <div class="mx-auto max-w-[88rem] px-6 pt-16 pb-12 md:px-10 md:pt-24 md:pb-16 lg:px-16">
    <p class="font-mono text-[11px] tracking-[0.18em] text-horizon-600 sm:text-xs">
      {site.eyebrow}
    </p>
    <div class="mt-8 max-w-xl">
      <h1 class="text-[2rem] leading-[1.15] font-medium tracking-tight text-ink md:text-[2.75rem]">
        {site.hero}
      </h1>
      <p class="mt-8 text-[1.05rem] leading-relaxed text-muted">
        {site.support}
      </p>
      <p class="mt-4 text-[1.05rem] leading-relaxed text-muted">
        {site.sub}
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <CtaLink href="/products">Explore our systems</CtaLink>
        <CtaLink href="/contact" variant="secondary">Talk to us</CtaLink>
      </div>
    </div>
    <ResolutionMark class="mt-16 md:mt-20" />
  </div>
</section>
