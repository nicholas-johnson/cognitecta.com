---
import Section from '../Section.astro';
import { capabilities } from '../../data/site';
---

<Section class="pb-16 md:pb-24">
  <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">
    Selected capabilities
  </p>
  <ol class="grid grid-cols-1 border-t border-hairline sm:grid-cols-2 lg:grid-cols-4">
    {
      capabilities.map((item, index) => (
        <li
          class:list={[
            'border-b border-hairline py-5 pr-6',
            index % 2 === 0 && 'sm:border-r sm:pr-8',
            index % 2 === 1 && 'sm:pl-8',
            index % 4 !== 3 && 'lg:border-r lg:pr-8',
            index % 4 !== 0 && 'lg:pl-8',
          ]}
        >
          <span class="font-mono text-[11px] tracking-[0.18em] text-muted">{item.id}</span>
          <p class="mt-3 text-[1rem] tracking-tight">{item.title}</p>
        </li>
      ))
    }
  </ol>
</Section>
