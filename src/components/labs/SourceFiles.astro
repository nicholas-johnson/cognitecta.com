---
import { Code } from 'astro:components';

interface SourceFile {
  filename: string;
  lang: string;
  content: string;
}

interface Props {
  files: SourceFile[];
}

const { files } = Astro.props;

function heading(filename: string) {
  if (filename === 'start.py') return 'start.py';
  if (filename === 'test_start.py') return 'Tests';
  if (filename === 'solution.py') return 'Solution';
  return filename;
}
---

{
  files.length > 0 && (
    <section class="mt-16">
      <h2 class="text-[1.15rem] font-medium tracking-tight">Source</h2>
      <p class="mt-3 max-w-2xl text-[0.98rem] leading-relaxed text-muted">
        These files are from the repository. Clone it to run them; they will not execute in the browser.
      </p>
      <div class="mt-8 space-y-8">
        {files.map((file) => {
          const block = (
            <div class="overflow-x-auto border border-hairline bg-paper">
              <Code code={file.content} lang={file.lang} theme="github-light" />
            </div>
          );
          if (file.filename === 'solution.py') {
            return (
              <details class="group border-t border-hairline pt-6">
                <summary class="cursor-pointer font-mono text-[11px] tracking-[0.16em] text-ink hover:text-cobalt">
                  {heading(file.filename)} — show
                </summary>
                <div class="mt-4">{block}</div>
              </details>
            );
          }
          return (
            <div>
              <h3 class="mb-3 font-mono text-[11px] tracking-[0.16em] text-muted">{heading(file.filename)}</h3>
              {block}
            </div>
          );
        })}
      </div>
    </section>
  )
}
