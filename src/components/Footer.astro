---
import Wordmark from './Wordmark.astro';
import { site, pillars } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-hairline">
  <div
    class="mx-auto flex max-w-[88rem] flex-col gap-10 px-6 py-10 md:flex-row md:items-end md:justify-between md:px-10 lg:px-16"
  >
    <div>
      <Wordmark class="text-[0.7rem] tracking-[0.28em]" />
      <p class="mt-3 font-mono text-[11px] tracking-[0.14em] text-muted">
        {site.line}
      </p>
    </div>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          pillars.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-mono text-[11px] tracking-[0.14em] text-ink no-underline hover:text-cobalt"
              >
                {item.title}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/insights"
            class="font-mono text-[11px] tracking-[0.14em] text-ink no-underline hover:text-cobalt"
          >
            Insights
          </a>
        </li>
      </ul>
    </nav>
    <div class="flex flex-col gap-2 font-mono text-[11px] tracking-[0.12em] text-muted md:items-end">
      <a href={`mailto:${site.email}`} class="text-ink no-underline hover:text-cobalt">
        {site.email}
      </a>
      <p>© {year} Cognitecta</p>
    </div>
  </div>
</footer>
