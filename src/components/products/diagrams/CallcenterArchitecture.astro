---
import GridFrame from '../../diagrams/GridFrame.astro';
import { callcenterArchitecture } from '../../../data/callcenter';

interface Props {
  caption?: string;
}

const { caption = 'Figure · Callcenter architecture' } = Astro.props;
---

<figure>
  <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">{caption}</p>
  <GridFrame class="overflow-hidden bg-paper">
    <div class="callcenter-arch space-y-0">
      <div class="border-b border-hairline px-5 py-5 md:px-8">
        <p class="font-mono text-[11px] tracking-[0.16em] text-muted">Customer channels</p>
        <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
          {
            callcenterArchitecture.channels.map((item) => (
              <li class="border border-hairline px-3 py-3 text-center font-mono text-[11px] tracking-[0.14em] uppercase">
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="callcenter-arch__layer border-b border-hairline bg-ink/[0.02] px-5 py-5 md:px-8">
        <p class="text-center font-mono text-[11px] tracking-[0.22em] text-cobalt uppercase">
          {callcenterArchitecture.layer}
        </p>
      </div>

      <div class="border-b border-hairline px-5 py-5 md:px-8">
        <ul class="grid gap-2 sm:grid-cols-3">
          {
            callcenterArchitecture.core.map((item) => (
              <li class="border border-hairline px-3 py-3 text-center font-mono text-[11px] tracking-[0.14em] uppercase">
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="border-b border-hairline px-5 py-5 md:px-8">
        <p class="border border-cobalt px-3 py-4 text-center font-mono text-[11px] tracking-[0.22em] text-cobalt uppercase">
          {callcenterArchitecture.team}
        </p>
      </div>

      <div class="border-b border-hairline px-5 py-5 md:px-8">
        <p class="font-mono text-[11px] tracking-[0.16em] text-muted">Connected systems</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            callcenterArchitecture.systems.map((item) => (
              <li class="border border-hairline px-2.5 py-1 font-mono text-[11px] tracking-[0.1em] text-muted">
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid gap-0 border-b border-hairline md:grid-cols-2">
        <div class="border-b border-hairline px-5 py-5 md:border-r md:border-b-0 md:px-8">
          <p class="font-mono text-[11px] tracking-[0.16em] text-cobalt">Resolve</p>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">
            Complete the permitted work and confirm the result inside the same conversation.
          </p>
        </div>
        <div class="px-5 py-5 md:px-8">
          <p class="font-mono text-[11px] tracking-[0.16em] text-cobalt">Handoff</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              callcenterArchitecture.handoff.map((item) => (
                <li class="border border-hairline px-2.5 py-1 font-mono text-[11px] tracking-[0.1em] text-muted">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="px-5 py-5 md:px-8">
        <p class="font-mono text-[11px] tracking-[0.16em] text-muted">Surrounding controls</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            callcenterArchitecture.surround.map((item) => (
              <li class="border border-hairline px-2.5 py-1 font-mono text-[11px] tracking-[0.1em] text-ink">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </GridFrame>
  <figcaption class="sr-only">
    Voice, WhatsApp, SMS and email enter a universal conversation layer, then identity, intent and orchestration, then an agent team connected to knowledge, Salesforce, tools, customer data and policies. Work either resolves or hands off to Teams, Slack, Salesforce or a human adviser, surrounded by identity, permissions, observability, evaluation, audit and guardrails.
  </figcaption>
</figure>
