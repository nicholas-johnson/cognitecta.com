---
import GridFrame from '../../diagrams/GridFrame.astro';
import { callcenterSwitching } from '../../../data/callcenter';

interface Props {
  caption?: string;
}

const { caption = 'Figure · Channel switching' } = Astro.props;
---

<figure>
  <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">{caption}</p>
  <GridFrame class="overflow-hidden bg-paper">
    <ol class="grid gap-0 sm:grid-cols-2 xl:grid-cols-5">
      {
        callcenterSwitching.map((item, index) => (
          <li
            class:list={[
              'border-hairline px-5 py-6',
              index < callcenterSwitching.length - 1 && 'border-b sm:border-b-0',
              index % 2 === 0 && 'sm:border-r',
              index < 4 && 'xl:border-r',
              index >= 2 && 'sm:border-t xl:border-t-0',
              index === 4 && 'sm:col-span-2 sm:border-t xl:col-span-1 xl:border-t-0',
            ]}
          >
            <p class="font-mono text-[11px] tracking-[0.16em] uppercase">{item.from}</p>
            <p class="mt-3 font-mono text-[11px] tracking-[0.18em] text-cobalt" aria-hidden="true">
              →
            </p>
            <p class="mt-3 font-mono text-[11px] tracking-[0.16em] text-muted uppercase">{item.to}</p>
          </li>
        ))
      }
    </ol>
  </GridFrame>
</figure>
