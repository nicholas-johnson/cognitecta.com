---
import GridFrame from '../../diagrams/GridFrame.astro';

interface Props {
  caption?: string;
}

const { caption = 'Figure · Many channels. One conversation.' } = Astro.props;

const channels = ['Voice', 'SMS', 'Email', 'WhatsApp'];
---

<figure>
  <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">{caption}</p>
  <GridFrame class="overflow-hidden bg-paper">
    <div class="grid gap-0 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.6fr)_minmax(0,0.9fr)]">
      <div class="border-b border-hairline px-5 py-6 lg:border-r lg:border-b-0">
        <p class="font-mono text-[11px] tracking-[0.16em] text-muted">Channels</p>
        <ul class="mt-5 space-y-2">
          {
            channels.map((item) => (
              <li class="border border-hairline px-3 py-2 font-mono text-[11px] tracking-[0.14em] uppercase">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="border-b border-hairline px-5 py-6 lg:border-r lg:border-b-0">
        <p class="font-mono text-[11px] tracking-[0.16em] text-muted">Service layer</p>
        <p class="mt-5 border border-cobalt px-4 py-5 text-center font-mono text-[11px] tracking-[0.18em] text-cobalt uppercase">
          Universal Conversation
        </p>
        <p class="mt-3 border border-hairline px-4 py-4 text-center font-mono text-[11px] tracking-[0.18em] uppercase">
          Agent Team
        </p>
        <p class="mt-6 text-[0.95rem] leading-relaxed text-muted">
          Customer identity and context travel with the interaction.
        </p>
      </div>
      <div class="px-5 py-6">
        <p class="font-mono text-[11px] tracking-[0.16em] text-muted">Outcomes</p>
        <p class="mt-5 border border-hairline px-4 py-4 font-mono text-[11px] tracking-[0.16em] uppercase">
          Resolve
        </p>
        <p class="mt-3 border border-hairline px-4 py-4 font-mono text-[11px] tracking-[0.16em] uppercase">
          Human handoff
        </p>
      </div>
    </div>
  </GridFrame>
</figure>
