---
import { funnelScoring } from '../../../data/products';

interface Props {
  caption?: string;
}

const { caption = 'Figure · Prioritisation dimensions' } = Astro.props;
---

<figure>
  <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">{caption}</p>
  <ol class="grid grid-cols-1 border border-hairline bg-paper sm:grid-cols-2 lg:grid-cols-3">
    {
      funnelScoring.map((item, index) => (
        <li
          class:list={[
            'border-hairline p-5',
            index % 2 === 0 && 'sm:border-r',
            index < 4 && 'border-b',
            index < 3 && 'lg:border-b',
            index % 3 !== 2 && 'lg:border-r',
            index === 4 && 'lg:border-r',
          ]}
        >
          <div class="flex items-baseline justify-between gap-4">
            <p class="font-mono text-[11px] tracking-[0.16em] text-muted">{item.id}</p>
            <p class="font-mono text-[11px] tracking-[0.12em] text-muted">{item.share}</p>
          </div>
          <h3 class="mt-3 text-[1.02rem] font-medium tracking-tight">{item.title}</h3>
          <p class="mt-2 text-[0.92rem] leading-relaxed text-muted">{item.body}</p>
          <div class="mt-4 h-1.5 bg-hairline">
            <div class="funnel-score h-1.5 bg-cobalt" style={`width: ${item.share}%`}></div>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="mt-4 font-mono text-[11px] tracking-[0.12em] text-muted">
    Illustrative scores — a prioritisation aid, not a probability of purchase.
  </p>
</figure>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .funnel-score {
      transform-origin: left center;
      animation: funnel-score 1s ease both;
    }
  }

  @keyframes funnel-score {
    from {
      transform: scaleX(0.08);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
