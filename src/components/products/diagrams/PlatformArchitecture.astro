---
import GridFrame from '../../diagrams/GridFrame.astro';
import { platformLayers } from '../../../data/products';

interface Props {
  caption?: string;
}

const { caption = 'Figure · Platform architecture' } = Astro.props;
---

<figure>
  <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">{caption}</p>
  <GridFrame class="overflow-hidden bg-paper">
    <ol class="platform-arch divide-y divide-hairline">
      {
        platformLayers.map((layer, index) => (
          <li class="relative px-5 py-5 md:px-8">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <p class="font-mono text-[11px] tracking-[0.18em] text-muted">{layer.id}</p>
              {index < platformLayers.length - 1 && (
                <span class="platform-arch__dot hidden size-1.5 bg-cobalt md:inline-block" aria-hidden="true" />
              )}
            </div>
            <p class="mt-3 text-[1.02rem] font-medium tracking-tight">{layer.title}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {layer.items.map((item) => (
                <li class="border border-hairline px-2.5 py-1 font-mono text-[11px] tracking-[0.1em] text-muted">
                  {item}
                </li>
              ))}
            </ul>
            {index < platformLayers.length - 1 && (
              <span
                class="platform-arch__flow pointer-events-none absolute bottom-0 left-8 hidden h-px w-16 bg-cobalt/70 md:block"
                aria-hidden="true"
              />
            )}
          </li>
        ))
      }
    </ol>
  </GridFrame>
  <figcaption class="sr-only">
    Events and requests enter an agent router, then an agent team, then tools, workflows, retrieval and memory, then enterprise systems and knowledge sources, with human escalation, observability and governance around the system.
  </figcaption>
</figure>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .platform-arch__dot {
      animation: platform-route 3.6s ease-in-out infinite;
    }
  }

  @keyframes platform-route {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 1;
    }
  }
</style>
