---
import GridFrame from '../../diagrams/GridFrame.astro';
import { callcenterAgents } from '../../../data/callcenter';

interface Props {
  caption?: string;
}

const { caption = 'Figure · Specialist agent model' } = Astro.props;
---

<figure>
  <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">{caption}</p>
  <GridFrame class="overflow-hidden bg-paper">
    <p class="border-b border-hairline px-5 py-3 font-mono text-[11px] tracking-[0.16em] text-muted md:px-8">
      Conceptual operating model — not a literal runtime topology
    </p>
    <ol class="grid gap-0 sm:grid-cols-2 xl:grid-cols-3">
      {
        callcenterAgents.map((agent, index) => (
          <li
            class:list={[
              'border-hairline px-5 py-5',
              index < callcenterAgents.length - 1 && 'border-b',
              index % 2 === 0 && 'sm:border-r',
              index < 9 && 'xl:border-b',
              (index + 1) % 3 !== 0 && 'xl:border-r',
              index >= 9 && 'xl:border-b-0',
            ]}
          >
            <p class="font-mono text-[11px] tracking-[0.14em] text-cobalt">{agent.title}</p>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{agent.body}</p>
          </li>
        ))
      }
    </ol>
  </GridFrame>
</figure>
