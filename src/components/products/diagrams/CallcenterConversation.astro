---
import GridFrame from '../../diagrams/GridFrame.astro';
import { callcenterJourney, callcenterConversationState } from '../../../data/callcenter';

interface Props {
  caption?: string;
}

const { caption = 'Figure · Universal Conversation' } = Astro.props;
---

<figure>
  <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">{caption}</p>
  <GridFrame class="overflow-hidden bg-paper">
    <div class="border-b border-hairline px-5 py-4 md:px-8">
      <p class="font-mono text-[11px] tracking-[0.22em] text-cobalt">Universal Conversation</p>
      <p class="mt-2 max-w-xl text-[0.95rem] leading-relaxed text-muted">
        One shared conversation state. Changing channel should not open a new case.
      </p>
    </div>
    <ol class="callcenter-journey grid gap-0 md:grid-cols-4">
      {
        callcenterJourney.map((step, index) => (
          <li
            class:list={[
              'relative border-hairline px-5 py-6 md:px-6',
              index < callcenterJourney.length - 1 && 'border-b md:border-r md:border-b-0',
            ]}
          >
            <p class="font-mono text-[11px] tracking-[0.18em] text-muted">{step.time}</p>
            <p class="mt-3 font-mono text-[11px] tracking-[0.16em] text-cobalt uppercase">{step.channel}</p>
            <p class="mt-4 text-[1.02rem] leading-snug tracking-tight">{step.line}</p>
            {index < callcenterJourney.length - 1 && (
              <span
                class="callcenter-journey__pulse pointer-events-none absolute -bottom-1.5 left-1/2 z-10 size-2.5 -translate-x-1/2 bg-cobalt md:top-1/2 md:-right-1.5 md:bottom-auto md:left-auto md:-translate-y-1/2 md:translate-x-0"
                aria-hidden="true"
              />
            )}
          </li>
        ))
      }
    </ol>
    <div class="border-t border-hairline px-5 py-5 md:px-8">
      <p class="font-mono text-[11px] tracking-[0.16em] text-muted">Shared state</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          callcenterConversationState.map((item) => (
            <li class="border border-hairline px-2.5 py-1 font-mono text-[11px] tracking-[0.1em] text-muted">
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </GridFrame>
  <figcaption class="sr-only">
    An illustrative customer journey moving from email at 09:10, to WhatsApp at 10:24, to a voice call at 11:03, then a human handoff at 11:07, all held in one conversation.
  </figcaption>
</figure>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .callcenter-journey__pulse {
      animation: callcenter-pulse 2.8s ease-in-out infinite;
    }
  }

  @keyframes callcenter-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: translate(-50%, 0) scale(0.85);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
  }

  @media (min-width: 768px) {
    @keyframes callcenter-pulse {
      0%,
      100% {
        opacity: 0.35;
        transform: translate(0, -50%) scale(0.85);
      }
      50% {
        opacity: 1;
        transform: translate(0, -50%) scale(1);
      }
    }
  }
</style>
