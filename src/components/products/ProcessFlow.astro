---
import type { ProcessStep } from '../../data/products';

interface Props {
  steps: readonly ProcessStep[];
  caption?: string;
  compact?: boolean;
}

const { steps, caption, compact = false } = Astro.props;
const columns = steps.length === 8 ? 4 : steps.length > 6 ? 3 : 0;
---

<div>
  {caption && <p class="mb-4 font-mono text-[11px] tracking-[0.18em] text-muted">{caption}</p>}
  <ol
    class:list={[
      'process-flow flex flex-col border border-hairline md:flex-row md:flex-wrap',
      compact ? 'bg-paper' : 'bg-paper',
    ]}
  >
    {
      steps.map((step, index) => (
        <li
          class:list={[
            'relative flex min-w-0 flex-1 flex-col border-hairline px-4 py-5 md:min-w-[10rem] md:border-b-0',
            index < steps.length - 1 && 'border-b md:border-r',
            columns === 3 && 'md:min-w-[calc(33.333%-1px)] md:flex-none md:basis-1/3',
            columns === 4 && 'md:min-w-[calc(25%-1px)] md:flex-none md:basis-1/4',
            columns > 0 && index >= columns && 'md:border-t',
            columns > 0 && (index + 1) % columns === 0 && 'md:border-r-0',
          ]}
        >
          <span class="font-mono text-[11px] tracking-[0.18em] text-muted">{step.id}</span>
          <p
            class:list={[
              'mt-3 font-medium tracking-tight uppercase',
              compact ? 'text-[0.92rem]' : 'text-[1.02rem]',
            ]}
          >
            {step.title}
          </p>
          {step.body && (
            <p class="mt-2 text-[0.92rem] leading-relaxed text-muted">{step.body}</p>
          )}
          {index < steps.length - 1 && !(columns > 0 && (index + 1) % columns === 0) && (
            <span
              class="process-flow__pulse pointer-events-none absolute -bottom-1.5 left-1/2 z-10 size-2.5 -translate-x-1/2 bg-cobalt md:top-1/2 md:-right-1.5 md:bottom-auto md:left-auto md:-translate-y-1/2 md:translate-x-0"
              aria-hidden="true"
            />
          )}
        </li>
      ))
    }
  </ol>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .process-flow__pulse {
      animation: process-pulse 2.8s ease-in-out infinite;
    }
  }

  @keyframes process-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: translate(-50%, 0) scale(0.85);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
  }

  @media (min-width: 768px) {
    @keyframes process-pulse {
      0%,
      100% {
        opacity: 0.35;
        transform: translate(0, -50%) scale(0.85);
      }
      50% {
        opacity: 1;
        transform: translate(0, -50%) scale(1);
      }
    }
  }
</style>
