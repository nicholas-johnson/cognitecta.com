---
interface Props {
  class?: string;
  title?: string;
  plan?: boolean;
}

const { class: className, title, plan = false } = Astro.props;

const slot = 20;
const pad = 2.2;
const size = 15.6;
const cells: { c: number; r: number; filled: boolean }[] = [];

for (let r = 0; r < 5; r++) {
  for (let c = 0; c < 5; c++) {
    const filled = c < 2 || r === 0 || r === 4;
    cells.push({ c, r, filled });
  }
}
---

<svg
  class:list={['block', className]}
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
>
  {title && <title>{title}</title>}
  {cells.map(({ c, r, filled }) => (
    <rect
      x={c * slot + pad}
      y={r * slot + pad}
      width={size}
      height={size}
      fill={filled ? 'currentColor' : plan ? 'currentColor' : 'none'}
      fill-opacity={filled ? 1 : plan ? 0.08 : 0}
    />
  ))}
</svg>
