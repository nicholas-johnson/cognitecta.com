---
import LabLayout from '../../../../layouts/LabLayout.astro';
import { getCollection } from 'astro:content';
import { getLabSource, isLabProgramme, labIndexHref, labModuleHref } from '../../../../data/labs';
import { getProgramme, programmeHref } from '../../../../data/programmes';
import { groupedLabs } from '../../../../lib/labs';
import { site } from '../../../../data/site';
import { productHref } from '../../../../data/products';

export function getStaticPaths() {
  return [
    { params: { programme: 'ai-engineering' } },
    { params: { programme: 'applied-nlp' } },
  ];
}

const { programme: programmeSlug } = Astro.params;
if (!programmeSlug || !isLabProgramme(programmeSlug)) {
  throw new Error(`Unknown lab programme: ${programmeSlug}`);
}

const programme = getProgramme(programmeSlug);
const source = getLabSource(programmeSlug);
if (!programme || !source) throw new Error(`Unknown programme: ${programmeSlug}`);

const labs = await getCollection('labs');
const groups = groupedLabs(labs, programmeSlug);
const pageUrl = new URL(`${labIndexHref(programmeSlug)}/`, Astro.site).toString();
const landingUrl = new URL(`${programmeHref(programmeSlug)}/`, Astro.site).toString();

const description = `Lab handbook for ${programme.title}: module notes and exercises from the private Python programme. Clone the repository to run the labs.`;

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${programme.title} lab handbook`,
  description,
  url: pageUrl,
  numberOfItems: groups.length,
  itemListElement: groups.map((group, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`${labModuleHref(programmeSlug, group.module.data.moduleSlug)}/`, Astro.site).toString(),
    name: group.module.data.title,
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Training', item: `${site.url}/training/` },
    { '@type': 'ListItem', position: 3, name: programme.title, item: landingUrl },
    { '@type': 'ListItem', position: 4, name: 'Lab handbook', item: pageUrl },
  ],
};
---

<LabLayout
  title={`${programme.title} lab handbook`}
  description={description}
  kicker="Lab handbook"
  programmeSlug={programmeSlug}
  githubUrl={source.githubUrl}
  crumbs={[
    { href: '/training', label: 'Training' },
    { href: programmeHref(programmeSlug), label: programme.title },
    { href: labIndexHref(programmeSlug), label: 'Labs' },
  ]}
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <p>
    {source.theme} is the framing of the taught labs. The notes below are the module READMEs from the
    course repository, kept in sync when that repository changes.
  </p>

  {
    groups.length === 0 ? (
      <p class="mt-8">
        The handbook sources were not available at build time. Read the material on
        {' '}
        <a href={source.githubUrl}>GitHub</a>
        {' '}
        or clone the repository.
      </p>
    ) : (
      <ol class="mt-10 border-t border-hairline">
        {groups.map((group) => (
          <li class="border-b border-hairline py-8">
            <p class="font-mono text-[11px] tracking-[0.18em] text-muted">
              Module {group.module.data.moduleId}
            </p>
            <h2 class="mt-2 text-[1.15rem] font-medium tracking-tight">
              <a
                href={labModuleHref(programmeSlug, group.module.data.moduleSlug)}
                class="text-ink no-underline hover:text-cobalt"
              >
                {group.module.data.title}
              </a>
            </h2>
            <p class="mt-3 max-w-2xl text-[0.98rem] leading-relaxed">{group.module.data.description}</p>
            {group.exercises.length > 0 && (
              <ol class="mt-5 space-y-2">
                {group.exercises.map((exercise) => (
                  <li class="grid grid-cols-[auto_1fr] gap-3">
                    <span class="font-mono text-[11px] tracking-[0.14em] text-muted">
                      {exercise.data.exerciseSlug?.slice(0, 2)}
                    </span>
                    <a
                      href={labModuleHref(programmeSlug, group.module.data.moduleSlug) + '/' + exercise.data.exerciseSlug}
                      class="text-ink no-underline hover:text-cobalt"
                    >
                      {exercise.data.title}
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    )
  }

  {
    source.relatedProducts.length > 0 && (
      <section class="mt-14">
        <h2 class="text-[1.15rem] font-medium tracking-tight">Related products</h2>
        <p class="mt-4">
          The same concerns — tools, retrieval, agents, production controls — show up in Linear Horizon
          products.
        </p>
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          {source.relatedProducts.map((product) => (
            <li>
              <a href={productHref(product.slug)} class="text-ink hover:text-cobalt">
                {product.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</LabLayout>
