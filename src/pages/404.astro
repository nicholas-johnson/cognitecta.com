---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="The page you requested could not be found." noindex>
  <article class="mx-auto max-w-[88rem] px-6 py-24 md:px-10 lg:px-16">
    <p class="font-mono text-[11px] tracking-[0.18em] text-cobalt">404</p>
    <h1 class="mt-4 text-[2rem] font-medium tracking-tight md:text-[2.5rem]">
      This page could not be found.
    </h1>
    <p class="mt-6 text-[1.05rem] text-muted">
      <a href="/" class="text-ink hover:text-cobalt">Return to Linear Horizon</a>
    </p>
  </article>
</BaseLayout>
