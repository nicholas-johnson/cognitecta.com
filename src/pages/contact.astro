---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { site, interests, interestAliases } from '../data/site';
import { courses } from '../data/courses';

const courseLabels = Object.fromEntries(courses.map((course) => [course.slug, course.title]));
---

<BaseLayout
  title="Contact"
  description="Talk to Cognitecta about training, consulting, a bespoke system, or a Platform, Stack, Wargame or Funnel deployment."
>
  <article class="mx-auto max-w-[88rem] px-6 py-16 md:px-10 md:py-24 lg:px-16">
    <PageIntro kicker="08 / Contact" title="Talk to us.">
      <p>
        Write with a short account of the organisation and the problem. Serious enquiries receive a reply. If email is easier, use
        {' '}
        <a href={`mailto:${site.email}`} class="text-ink hover:text-cobalt">{site.email}</a>.
      </p>
    </PageIntro>

    <form id="enquiry" class="mt-14 max-w-xl border-t border-ink/20 pt-10">
      <p id="course-note" class="mb-8 hidden font-mono text-[11px] tracking-[0.14em] text-muted"></p>
      <input type="hidden" name="course" id="course-field" />
      <div class="space-y-8">
        <label class="block">
          <span class="font-mono text-[11px] tracking-[0.18em] text-muted">Name</span>
          <input
            type="text"
            name="name"
            required
            autocomplete="name"
            class="mt-2 w-full border border-hairline bg-paper px-3 py-3 text-[1rem] text-ink outline-none"
          />
        </label>
        <label class="block">
          <span class="font-mono text-[11px] tracking-[0.18em] text-muted">Organisation</span>
          <input
            type="text"
            name="organisation"
            required
            autocomplete="organization"
            class="mt-2 w-full border border-hairline bg-paper px-3 py-3 text-[1rem] text-ink outline-none"
          />
        </label>
        <label class="block">
          <span class="font-mono text-[11px] tracking-[0.18em] text-muted">Interest</span>
          <select
            name="interest"
            class="mt-2 w-full appearance-none rounded-none border border-hairline bg-paper px-3 py-3 text-[1rem] text-ink outline-none"
          >
            {
              interests.map((item) => (
                <option value={item.value} selected={item.value === 'train'}>
                  {item.label}
                </option>
              ))
            }
          </select>
        </label>
        <label class="block">
          <span class="font-mono text-[11px] tracking-[0.18em] text-muted">Context</span>
          <textarea
            name="context"
            required
            rows="6"
            class="mt-2 w-full resize-y border border-hairline bg-paper px-3 py-3 text-[1rem] text-ink outline-none"
            placeholder="The organisation, the problem, and whether this is training, a system, or a product conversation."
          ></textarea>
        </label>
      </div>
      <button
        type="submit"
        class="mt-10 bg-cobalt px-6 py-3 font-mono text-[11px] tracking-[0.16em] text-white transition-colors hover:bg-ink"
      >
        Talk to us
      </button>
    </form>
  </article>
</BaseLayout>

<script define:vars={{ email: site.email, interestLabels: Object.fromEntries(interests.map((item) => [item.value, item.label])), interestAliases, courseLabels }}>
  const form = document.getElementById('enquiry');
  if (form instanceof HTMLFormElement) {
    const params = new URLSearchParams(window.location.search);
    const interestField = form.elements.namedItem('interest');
    const requestedProgramme = params.get('programme');
    const rawInterest = params.get('interest');
    const requestedInterest =
      rawInterest && rawInterest in interestAliases ? interestAliases[rawInterest] : rawInterest;
    const requestedCourse = params.get('course');
    const courseNote = document.getElementById('course-note');
    const courseField = document.getElementById('course-field');
    const courseTitle =
      requestedCourse && requestedCourse in courseLabels ? courseLabels[requestedCourse] : '';

    if (interestField instanceof HTMLSelectElement) {
      if (requestedProgramme && requestedProgramme in interestLabels) {
        interestField.value = requestedProgramme;
      } else if (requestedInterest && requestedInterest in interestLabels) {
        interestField.value = requestedInterest;
      } else if (courseTitle) {
        interestField.value = 'train';
      }
    }

    if (courseTitle && courseNote instanceof HTMLElement && courseField instanceof HTMLInputElement) {
      courseNote.textContent = `Course: ${courseTitle}`;
      courseNote.classList.remove('hidden');
      courseField.value = courseTitle;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const organisation = String(data.get('organisation') ?? '').trim();
      const interestValue = String(data.get('interest') ?? '').trim();
      const interest = interestLabels[interestValue] ?? interestValue;
      const course = String(data.get('course') ?? '').trim();
      const context = String(data.get('context') ?? '').trim();
      const subjectLabel = course || interest;
      const subject = `Cognitecta enquiry — ${organisation} — ${subjectLabel}`;
      const courseLine = course ? `Course: ${course}\n` : '';
      const body = `Name: ${name}\nOrganisation: ${organisation}\nInterest: ${interest}\n${courseLine}\n${context}`;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
